@namespace Galileo.DesignSystem.Demo.Pages.Organisms

<Showcase Title="Dialog" Description="Een modal voor gerichte acties, informatie of bevestiging." Source="@Source">
    <div class="demo-row">
        <GdsButton data-gds-dialog-open="dialog-host-example">
            Open DialogHost-demo
        </GdsButton>
    </div>

    <GdsDialog Id="dialog-host-example" Title="Gegevens bekijken">
        <ChildContent>
            <GdsText>
                De DialogHost beheert deze dialog, terwijl GdsDialog de header, body en footer rendert.
            </GdsText>
            <br />
            <GdsText>
                <strong>Voorbeelddata:</strong> een algemene demonstratie van content binnen de dialog.
            </GdsText>
        </ChildContent>

        <Footer>
            <GdsButton Type="@ButtonType.Outline"
                       Variant="@ButtonVariant.Tertiary"
                       data-gds-dialog-open="dialog-host-second">
                Open tweede dialog
            </GdsButton>
            <GdsButton data-gds-dialog-close="">
                Sluiten
            </GdsButton>
        </Footer>
    </GdsDialog>

    <GdsDialog Id="dialog-host-second" Title="Tweede dialog" Dismissible="false">
        <ChildContent>
            <GdsText>
                De eerste dialog blijft geopend onder deze dialog.
            </GdsText>
            <br />
            <GdsText>
                Sluit deze dialog om terug te keren naar de oorspronkelijke dialog.
            </GdsText>
        </ChildContent>

        <Footer>
            <GdsButton data-gds-dialog-close="">Terug</GdsButton>
        </Footer>
    </GdsDialog>
</Showcase>

@code {
    private const string Source = """
        <GdsDialogHost>
            <GdsButton data-gds-dialog-open="generic-dialog">
                Open dialog
            </GdsButton>

            <GdsDialog Id="generic-dialog" Title="Gegevens bekijken">
                <ChildContent>
                    <p>Dialog body content.</p>
                </ChildContent>

                <Footer>
                    <GdsButton data-gds-dialog-close>Sluiten</GdsButton>
                </Footer>
            </GdsDialog>
        </GdsDialogHost>
        """;
}
