@namespace Galileo.DesignSystem.Demo.Pages.Organisms

<Showcase Title="Dialog" Description="Een modal voor gerichte acties, informatie of bevestiging." Source="@Source">
    <div class="demo-row">
        <GdsButton data-gds-dialog-open="dialog-overview-example">
            Open dialog
        </GdsButton>
    </div>

    <GdsDialog Id="dialog-overview-example" Title="Profiel bijwerken">
        <ChildContent>
            <p>Pas je profielgegevens aan. De wijzigingen worden pas opgeslagen na bevestiging.</p>
        </ChildContent>

        <Footer>
            <GdsButton Type="@ButtonType.Outline"
                       Variant="@ButtonVariant.Tertiary"
                       data-gds-dialog-close="">
                Annuleren
            </GdsButton>
            <GdsButton data-gds-dialog-close="">
                Opslaan
            </GdsButton>
        </Footer>
    </GdsDialog>
</Showcase>

@code {
    private const string Source = """
        <GdsButton data-gds-dialog-open="profile-dialog">
            Open dialog
        </GdsButton>

        <GdsDialog Id="profile-dialog" Title="Profiel bijwerken">
            <p>Pas je profielgegevens aan.</p>

            <Footer>
                <GdsButton data-gds-dialog-close="">Annuleren</GdsButton>
                <GdsButton data-gds-dialog-close="">Opslaan</GdsButton>
            </Footer>
        </GdsDialog>
        """;
}
