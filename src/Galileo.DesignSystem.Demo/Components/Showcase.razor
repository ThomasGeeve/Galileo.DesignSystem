@namespace Galileo.DesignSystem.Demo.Components

<section id="@Id" class="showcase">
    <GdsCard FooterContent="@SourceContent">
        <HeaderContent>
            <div class="showcase__heading">
                <GdsText Type="@TextType.Headline">@Title</GdsText>

                @if (!string.IsNullOrWhiteSpace(Description))
                {
                    <GdsText Type="@TextType.Body" ClassName="showcase__description">@Description</GdsText>
                }
            </div>
        </HeaderContent>

        <ChildContent>
            <div class="showcase__demo">
                @ChildContent
            </div>
        </ChildContent>

    </GdsCard>
</section>

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Source { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private RenderFragment? SourceContent => string.IsNullOrWhiteSpace(Source)
        ? null
        : @<details class="showcase__source">
            <summary>Voorbeeldcode</summary>
            <pre><code>@Source</code></pre>
        </details>;
}
