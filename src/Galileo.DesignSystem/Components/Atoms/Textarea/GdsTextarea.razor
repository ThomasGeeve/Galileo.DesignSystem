@namespace Galileo.DesignSystem.Atoms

<textarea class="@CssClass"
          @attributes="AdditionalAttributes"
          name="@Name"
          id="@Id"
          placeholder="@Placeholder"
          rows="@Rows"
          required="@(Required ? "required" : null)"
          disabled="@(Disabled ? "disabled" : null)"
          readonly="@(Readonly ? "readonly" : null)">@Value</textarea>

@code {
    [Parameter] public string? Name { get; set; }

    [Parameter] public string? Id { get; set; }

    [Parameter] public string? Value { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    [Parameter] public int Rows { get; set; } = 4;

    [Parameter] public bool Required { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool Readonly { get; set; }

    [Parameter] public InputSize Size { get; set; } = InputSize.Md;

    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => $"gds-textarea gds-textarea--{Size.ToString().ToLowerInvariant()}";
}
