@namespace Galileo.DesignSystem.Atoms

<svg class="@CssClass" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" style="@Style" @attributes="AdditionalAttributes">
    <path d="@Path" />
</svg>

@code {
    [Parameter] public string Name { get; set; } = string.Empty;

    [Parameter] public IconSize? Size { get; set; }

    [Parameter] public string? Color { get; set; }

    [Parameter] public string? ClassName { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass
    {
        get
        {
            var classes = new List<string>();

            if (!string.IsNullOrWhiteSpace(ClassName))
                classes.Add(ClassName!);

            if (Size is not null)
                classes.Add($"gds-icon--{Size.Value.ToString().ToLowerInvariant()}");

            return classes.Count > 0 ? string.Join(' ', classes) : "gds-icon";
        }
    }

    private string? Style => !string.IsNullOrWhiteSpace(Color) ? $"color: {Color}" : null;

