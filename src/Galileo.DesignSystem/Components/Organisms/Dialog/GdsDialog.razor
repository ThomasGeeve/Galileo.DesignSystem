@namespace Galileo.DesignSystem.Organisms

<dialog id="@Id"
        class="gds-dialog"
        aria-labelledby="@TitleId"
        data-gds-dialog
        data-gds-dialog-dismissible="@DismissibleAttribute"
        @attributes="AdditionalAttributes">
    <div class="gds-dialog__surface">
        @if (!string.IsNullOrWhiteSpace(Title) || Dismissible)
        {
            <header class="gds-dialog__header">
                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    <h2 id="@TitleId" class="gds-dialog__title">@Title</h2>
                }

                @if (Dismissible)
                {
                    <GdsIconButton Icon="close"
                                    Type="@IconButtonType.Outline"
                                    Variant="@IconButtonVariant.Tertiary"
                                    Size="@IconButtonSize.Sm"
                                    AriaLabel="Sluiten"
                                    data-gds-dialog-close />
                }
            </header>
        }

        <div class="gds-dialog__content">
            @ChildContent
        </div>

        @if (Footer is not null)
        {
            <footer class="gds-dialog__footer">
                @Footer
            </footer>
        }
    </div>
</dialog>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;

    [Parameter] public string? Title { get; set; }

    [Parameter] public bool Dismissible { get; set; } = true;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RenderFragment? Footer { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string? TitleId => string.IsNullOrWhiteSpace(Title) ? null : $"{Id}-title";

    private string DismissibleAttribute => Dismissible ? "true" : "false";
}
